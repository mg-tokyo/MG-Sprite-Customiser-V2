{
  "name": "mg-sprite-customiser",
  "version": "2.0.1",
  "private": true,
  "description": "Sprite customiser for Magic Garden",
  "license": "MIT",
  "keywords": ["magic-garden", "sprite-editor", "pixi", "typescript", "vite"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-env.mjs && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "eslint": "^9.39.3",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@rive-app/canvas-advanced": "^2.35.0",
    "gif.js": "^0.2.0",
    "omggif": "^1.0.10"
  },
  "overrides": {
    "rollup": "^4.59.0",
    "minimatch": "^3.1.4",
    "ajv": "^6.14.0"
  }
}
